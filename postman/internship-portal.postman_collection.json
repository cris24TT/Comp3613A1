{
  "info": {
    "name": "Internship Application Portal API",
    "description": "COMP 3613 Assignment 2: API tests for the four workflows (Apply, Review, Track Status, View Details) plus authentication and authorization. Run the folders in order with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Register a fresh student",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{studentUsername}}",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "{{studentUsername}}@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{studentPassword}}",
                  "type": "text"
                }
              ]
            },
            "description": "Creates a new student account through the registration form so every run starts clean."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new student each run keeps the collection repeatable (no \"already applied\" clash).",
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set(\"studentUsername\", \"postman_student_\" + suffix);",
                  "pm.collectionVariables.set(\"studentPassword\", \"postmanpass\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registration request is accepted\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 303]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as student",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{studentUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{studentPassword}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns a bearer access token\", function () {",
                  "    pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(body.token_type).to.eql(\"bearer\");",
                  "});",
                  "pm.test(\"Role is student\", function () { pm.expect(body.role).to.eql(\"student\"); });",
                  "pm.collectionVariables.set(\"studentToken\", body.access_token);"
                ]
              }
            }
          ]
