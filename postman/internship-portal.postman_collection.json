                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "resume_file",
                  "type": "file",
                  "src": "sample-resume.pdf"
                },
                {
                  "key": "position_id",
                  "value": "{{positionId}}",
                  "type": "text"
                },
                {
                  "key": "first_name",
                  "value": "Postman",
                  "type": "text"
                },
                {
                  "key": "last_name",
                  "value": "Student",
                  "type": "text"
                },
                {
                  "key": "major",
                  "value": "Computer Science",
                  "type": "text"
                },
                {
                  "key": "graduation_year",
                  "value": "2027",
                  "type": "text"
                },
                {
                  "key": "cover_letter",
                  "value": "I would love to build internal tools with your team.",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test(\"New application is pending\", function () { pm.expect(body.status).to.eql(\"pending\"); });",
                  "pm.test(\"Semester comes from the position's offering year\", function () {",
                  "    pm.expect(body.semester).to.match(/^Summer \\d{4}$/);",
                  "});",
                  "pm.test(\"Application is for the chosen position\", function () {",
                  "    pm.expect(body.position_id).to.eql(Number(pm.collectionVariables.get(\"positionId\")));",
                  "});",
                  "pm.collectionVariables.set(\"applicationId\", body.application_id);"
                ]
              }
            }
          ]
        },
