    {
      "name": "4. Track Status and View Details",
      "item": [
        {
          "name": "Track application status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
