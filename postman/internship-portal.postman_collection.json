    {
      "name": "2. Apply for Internship",
      "item": [
        {
          "name": "List open positions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/positions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "positions"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const positions = pm.response.json();",
                  "pm.test(\"Returns a non-empty list of positions\", function () {",
                  "    pm.expect(positions).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "pm.test(\"Each position has the expected fields\", function () {",
                  "    positions.forEach(function (p) {",
                  "        pm.expect(p).to.have.all.keys(\"position_id\", \"title\", \"company\", \"department\",",
                  "                                       \"location\", \"work_type\", \"offering_year\");",
                  "    });",
                  "});",
                  "const target = positions.find(function (p) { return p.department === \"Computer Science\"; });",
                  "pm.test(\"A Computer Science position is available\", function () { pm.expect(target).to.exist; });",
                  "pm.collectionVariables.set(\"positionId\", target.position_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Apply for internship",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
